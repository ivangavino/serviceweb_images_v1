DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_proyecto_quinua
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURA
DB_ECHO=false
LOG_LEVEL=INFO

# Genere una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HMAC_MASTER_KEY=REEMPLAZAR_CON_CLAVE_FERNET
HMAC_TIMESTAMP_TOLERANCE=300
NONCE_TTL=600
NONCE_CLEANUP_INTERVAL=300
RATE_LIMIT_PER_MINUTE=60
ENFORCE_HTTPS=false
REQUEST_BODY_TIMEOUT_SECONDS=60

CROP_TIMEZONE=America/Lima
MAX_TOMAS_POR_SEMANA=2
MIN_SURCOS_POR_TOMA=1
MAX_SURCOS_POR_TOMA=20
MIN_LONGITUD_SURCO_METROS=30
MAX_LONGITUD_SURCO_METROS=100

IMAGE_STORAGE_ROOT=./imagenes_mildiu
IMAGE_STAGING_ROOT=./imagenes_mildiu/.staging
MAX_IMAGE_BYTES=10485760
MAX_UPLOAD_TOTAL_BYTES=52428800
MAX_METADATA_REQUEST_BYTES=1048576
MAX_FILES_PER_BATCH=25
MAX_IMAGE_PIXELS=50000000
ALLOWED_IMAGE_FORMATS=JPEG,PNG

